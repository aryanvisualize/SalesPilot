# ==========================================
# SalesPilot Client Environment Configuration
# ==========================================
# NOTE: Variables prefixed with VITE_ are exposed to the client bundle.
# NEVER put sensitive secrets, private keys, or passwords here.

# Backend API Base URL
# In local development, defaults to http://localhost:5000 if not set.
# In production, set this to your deployed Express backend URL (without trailing slash).
VITE_API_URL=https://your-salespilot-backend.onrender.com

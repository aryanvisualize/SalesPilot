# ==========================================
# SalesPilot Server Environment Configuration
# ==========================================

# Port the Express server listens on (Render/Railway/Heroku provide this automatically)
PORT=5000

# Application environment mode (development | production)
NODE_ENV=production

# MongoDB Connection String (Atlas or compatible MongoDB instance)
# Supported keys: MONGO_URI or MONGODB_URI
MONGO_URI=mongodb+srv://<db_username>:<db_password>@<cluster>.mongodb.net/<database_name>?retryWrites=true&w=majority

# JSON Web Token (JWT) Configuration
# Generate a secure random string (e.g., openssl rand -hex 32)
JWT_SECRET=your_secure_random_jwt_secret_key_here
JWT_EXPIRES_IN=1d

# Allowed Frontend Origins for CORS (comma-separated if multiple)
# In development, localhost:5173 and localhost:3000 are automatically allowed.
# In production, set this to your deployed frontend domain.
CLIENT_URL=https://your-salespilot-frontend.vercel.app

# Optional: Initial Admin Bootstrap (Used by 'npm run create-admin')
# ADMIN_EMAIL=admin@salespilot.com
# ADMIN_PASSWORD=ChangeThisPassword123!
